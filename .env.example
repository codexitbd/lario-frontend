# Backend / site addresses live in lario.config.ts. Override per environment if needed:
# LARIO_BACKEND_URL=https://admin.lario.sa
# LARIO_SITE_URL=https://lario.sa

# Shared with lario-backend (.env there). Revalidation no-ops when empty.
LARIO_REVALIDATE_SECRET=
# Server-to-server key: lets this server call the API without the public rate limit.
LARIO_API_KEY=

# Local Herd backend (self-signed HTTPS): `npm run dev` already points Node at
# Herd's certificate. Elsewhere, set NODE_EXTRA_CA_CERTS yourself if needed.
